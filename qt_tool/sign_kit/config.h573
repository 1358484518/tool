# H573 SPIFLASH 签名默认值，须与板上 SPE / BL2 一致。
# S 主槽 512 KB @ 0x0C044000，NS 主槽 1 MB @ 0x0C100000。
# 重编 SPE 若改了 MCUboot 选项，这里要一起改。

BL2_HEADER_SIZE=0x400
MCUBOOT_ALIGN_VAL=16
MCUBOOT_ENC_KEY_LEN=128
MCUBOOT_HW_KEY=ON
MCUBOOT_MEASURED_BOOT=ON
MCUBOOT_CONFIRM_IMAGE=OFF
MCUBOOT_ENC_IMAGES=OFF
# 与 stm32h573i_dk/config.cmake 一致。sign.sh 看到这个值才加 --overwrite-only。
MCUBOOT_UPGRADE_STRATEGY=OVERWRITE_ONLY

MCUBOOT_IMAGE_VERSION_S=2.3.1
MCUBOOT_SECURITY_COUNTER_S=1
MCUBOOT_NS_IMAGE_MIN_VER=0.0.0+0

MCUBOOT_IMAGE_VERSION_NS=0.0.0
MCUBOOT_SECURITY_COUNTER_NS=1
MCUBOOT_S_IMAGE_MIN_VER=0.0.0+0
